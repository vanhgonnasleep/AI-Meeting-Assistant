# Copy to .env in the repository root. Never commit the populated .env.
# Private mode requires sign-in; local explicitly selects the legacy offline library.
CLARION_AUTH_MODE=private

# Direct Windows/Python development:
CLARION_PUBLIC_URL=http://localhost:8002
CLARION_FRONTEND_URL=http://localhost:5173
# For Docker Compose, set BOTH URLs above to http://localhost:5173.
# For a deployed server, use HTTPS and list its hostname below.
CLARION_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Optional host paths. Defaults preserve the original local meeting database.
# CLARION_DATA_DIR=C:/path/to/private-data
# CLARION_DB_PATH=C:/path/to/local/meeting.db
# Compose persists identity + per-account databases within CLARION_DATA_PATH.
# CLARION_DATA_PATH=./database
