{"schema_version": 1, "case_id": "fleurs-vi-0002", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0002.audio", "audio_sha256": "43febdf828f97a7efc3a45180a99d76747d3c45bf9143fbf8bf62d7c0adedc26", "reference_text": "nó cũng tấn công mọi thứ trong nước ngay cả khủng long khổng lồ như t rex cũng không phải là đối thủ với nó", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 2, "reference_sha256": "9ce7c76fc54fcd44cc1a3f91d160a21a8f8aa05988e3d9688e4f70efbf6cb597", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0003", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0003.audio", "audio_sha256": "cca46c77040d86068a55feef4ef95b21289afba255b4a8db8b00d878545cf33f", "reference_text": "số người có mặt quá lớn nên việc mọi người tới được nơi tổ chức lễ tang tại quảng trường thánh peter là không thể", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 3, "reference_sha256": "42ee6e48e4cdfa46e38a7d4b433c93c5ce67db03c8f1a5145a667010d3650110", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0004", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0004.audio", "audio_sha256": "37e2cb772dbdc7c4cc70aece3e508a3c56ff2cf7519f8e28d2b7e310d77fdeda", "reference_text": "châu âu là lục địa tương đối nhỏ nhưng có nhiều quốc gia độc lập thông thường việc đi qua nhiều quốc gia đồng nghĩa với việc phải xin thị thực và xét hộ chiếu nhiều lần", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 4, "reference_sha256": "0b642987e7a5045153e21cf17f28166dc4497ab0612cb89bfafd00c5a20c92c9", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0005", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0005.audio", "audio_sha256": "8ac66d54510d2481167b649134d4674708e9fc2b6aa3890287a98f5fa83db313", "reference_text": "mọi danh từ kế bên từ sie dành cho bạn luôn bắt đầu bằng một chữ viết hoa ngay cả khi ở giữa câu", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 5, "reference_sha256": "8954e4e30c085ab17701ef7516beb55b85aaf63cec404240800a2f154a57c946", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0006", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0006.audio", "audio_sha256": "985195913a77e0889b14e85dd5628f12261d29d879ee272dd572da1a22855687", "reference_text": "thông báo thông thường trong khu metro chỉ được phát bằng tiếng catalunya tuy nhiên với những sự cố bất ngờ thì thông báo sẽ được thực hiên qua hệ thống tự động bằng nhiều thứ tiếng gồm tiếng tây ban nha tiếng anh tiếng pháp tiếng ả rập và tiếng nhật", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 6, "reference_sha256": "b33641be19f14e64a6621d0bcc577c65501377da31322aa3befa58b6e7258d48", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0007", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0007.audio", "audio_sha256": "c06fd5f367fb476ad23068ff7dda4c5151e028c62f3f5e364fd993503e669d07", "reference_text": "các nguyên tố như canxi và kali được coi là kim loại dĩ nhiên cũng có các kim loại như vàng và bạc", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 7, "reference_sha256": "f53010eabb256f86e0f684f3cca1a1d7f246004a40bf3b8e60cb4a257f7493cf", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0008", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0008.audio", "audio_sha256": "d1dcf34dd0757b8de5f5d891d1b4e1c0306b21372d459d7eac6c186eeb956dde", "reference_text": "hồ sơ theo vụ rò rỉ sẽ nhắc tới xung đột biên giới điều palestine muốn dựa trên đường biên giới trước cuộc chiến tranh trung đông 1967", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 8, "reference_sha256": "5aee01b1a14d41d7c2249c97d3d35ece78e9ddc8d88ab22d9adbacb880d07c9d", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0009", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0009.audio", "audio_sha256": "a7e0d97985f5e25b1ea2ccbbac32e65b1615ac330d5eaad61d4b0523495e0d2b", "reference_text": "trung hoa cổ đại có một cách thức độc đáo để trình bày những niên đại khác nhau mỗi một giai đoạn của trung hoa hoặc mỗi một gia tộc từng nắm giữ quyền lực tương ứng với một triều đại khác nhau", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 9, "reference_sha256": "2632f56d7a1864149fdb8db155b78b949f77d421d1337f9f39c7f6e1060f524c", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0010", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0010.audio", "audio_sha256": "f1fbdb4228de18fd1091283ad2249be453e2a0e41a076871504721652cf8d73f", "reference_text": "blog là công cụ kích thích sự hợp tác và khuyến khích học sinh mở rộng việc học tập ra ngoài khuôn khổ lớp học truyền thống", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 10, "reference_sha256": "bdc8e981731076e384311f37314bf36e17419f3dbc5e499b4c9f94fc5d4d335a", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0011", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0011.audio", "audio_sha256": "440adfbc6123029252dd3d875af0ea39bdebe897544e3b11fd4dac3caa711b41", "reference_text": "cụ thể người ta cho rằng một người có thể phát hiện ai đó đang nói dối bằng việc giải nghĩa chính xác từng biểu hiện rất nhỏ", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 11, "reference_sha256": "89fd0c044bdd43fde1b28fd8b470a88bc4fc839d25ae1d4772c8be21d78bfd5e", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0012", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0012.audio", "audio_sha256": "c5e8882163f972be6313721e4fac968740caf80fb14b60cff1c0d547c67a194d", "reference_text": "cái này gọi là độ ph của hóa chất bạn có thể tạo ra chất chỉ thị bằng nước ép bắp cải đỏ", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 12, "reference_sha256": "ff02075edc61c4519dd77c4bfd4da75d8144a806a470cdb04adfd5f85765d84e", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0013", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0013.audio", "audio_sha256": "42b6699e96d5daada1a45135ea5cee233e5a2ee04f66494cb2bab592a39b02c5", "reference_text": "tìm kiếm khóa học về môi trường thù địch trên internet có thể sẽ cung cấp cho bạn địa chỉ của một công ty địa phương", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 13, "reference_sha256": "5f0fdd2ebc92bb8182bfb4f58e0c9805432d47d72d078e8b7044800c88a24610", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0014", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0014.audio", "audio_sha256": "5ef51e213d39fa50e2b91d00df374c8e2680c5ca633e7561f2bae04e4e0c35e3", "reference_text": "bệnh viện này đã làm theo quy trình kiểm soát lây nhiễm bao gồm cách ly bệnh nhân với các bệnh nhân khác để ngăn ngừa lây nhiễm có thể có cho những người khác", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 14, "reference_sha256": "5cffbc2b7b381c298912042539416b22a93386c13d212f7a4fed2b0d0563132a", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0015", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0015.audio", "audio_sha256": "6a22d09400e524e283764c8894e7e08d2ef35ae95764d576889854bb57b03507", "reference_text": "tuy nhiên sau khi thua gôn của đội trưởng ấn độ chỉ thực hiện được 36 lần chạy và thua 7 gôn trước khi kết thúc hiệp thi đấu", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 15, "reference_sha256": "b86ca384c28d87ffc7f3c328f38177690a45351eb539b69a27817ad376af875b", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
{"schema_version": 1, "case_id": "fleurs-vi-0016", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0016.audio", "audio_sha256": "ac4c65f0c644b46f0ccac83f525113b6ae4007fea169c24b05c2e891cbcce5f1", "reference_text": "ông gọi những tin đồn này là cuộc tán gẫu về chính trị và sự điên rồ", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 16, "reference_sha256": "549927772fb4d771d114451d57023e1dff1304d39f68bded31c44acda1ee4b2d", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
