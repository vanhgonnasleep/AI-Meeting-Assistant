{"schema_version": 1, "case_id": "fleurs-vi-0000", "kind": "asr", "split": "test", "audio_path": "inputs/fleurs-vi-0000.audio", "audio_sha256": "33318a8f837de6c2953248729f658292c31520b57aa36ee0fe55c234d55c4b54", "reference_text": "văn hóa và bộ lạc cổ xưa đã bắt đầu giữ những con vật này để dễ lấy sữa tóc thịt và da", "reference_approved": false, "provenance": {"source_url": "https://huggingface.co/datasets/google/fleurs", "license": "CC-BY-4.0", "dataset": "google/fleurs", "config": "vi_vn", "split": "test", "row_index": 0, "reference_sha256": "fac515f496e5dda38c63e22096707cfb52f07ebf640e01eb4fb50e5712e69f1a", "parquet_url": "https://huggingface.co/datasets/google/fleurs/resolve/refs%2Fconvert%2Fparquet/vi_vn/test/0000.parquet", "parquet_sha256": "65325be18bef84bb97b5bad1145958ae752919bb0b6696e7cfa8409ef5c46c77"}, "reference_tasks": null, "reference_facts": null}
